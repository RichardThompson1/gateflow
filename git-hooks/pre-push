#!/bin/sh
# gateflow git hook: refuses a push made from inside a Claude Code session (CLAUDECODE=1 is set in every
# shell Claude Code spawns; a normal terminal does not set it, so the user's own pushes pass). Same
# bypass analysis as pre-commit.
if [ "${CLAUDECODE:-}" = "1" ]; then
  echo "BLOCKED (gateflow pre-push): pushes from a Claude Code session are refused; the user pushes." >&2
  exit 1
fi
exit 0
